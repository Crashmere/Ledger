[Unit]
Description=Ledger personal bookkeeping
After=network.target

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/var/lib/ledger
Environment=LEDGER_DB=/var/lib/ledger/ledger.sqlite
Environment=LEDGER_ADDR=0.0.0.0:8080
ExecStart=/opt/ledger/ledger serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ledger

[Install]
WantedBy=multi-user.target
