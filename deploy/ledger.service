[Unit]
Description=Ledger personal bookkeeping
After=network.target

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/opt/ledger
EnvironmentFile=/opt/ledger/config/ledger.env
ExecStart=/opt/ledger/bin/ledger serve
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ledger/data

[Install]
WantedBy=multi-user.target
