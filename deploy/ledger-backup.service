[Unit]
Description=Ledger daily SQLite backup

[Service]
Type=oneshot
User=ledger
Group=ledger
EnvironmentFile=/opt/ledger/config/ledger.env
ExecStart=/opt/ledger/bin/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ledger/data /opt/ledger/backups
